{
  "name": "clined",
  "version": "38.0.0",
  "private": true,
  "description": "CLINED Clinical Education — online medical learning platform with real-time account sync, strict CSP, persistent rate limiting, and telemetry.",
  "type": "module",
  "scripts": {
    "start": "node local-server.mjs",
    "dev": "node --watch local-server.mjs",
    "db:migrate": "node db/migrate.mjs",
    "db:seed": "node db/seed-question-banks.mjs",
    "admin:create": "node db/create-admin.mjs",
    "validate:banks": "node tools/validate-banks.mjs",
    "build:bundles": "node tools/build-bundles.mjs",
    "check:syntax": "node tools/check-quality.mjs --syntax",
    "check:css": "node tools/check-quality.mjs --css",
    "check:csp": "node tools/check-quality.mjs --csp",
    "check:all": "node tools/check-quality.mjs --all",
    "test": "node --test"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}
